# Existing LiveKit agent settings
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
LIVEKIT_URL=wss://your-livekit-host
GOOGLE_API_KEY=your_google_api_key
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_POST_CALL_MODEL=openai/gpt-oss-120b
GROQ_MAX_ATTEMPTS=2
GROQ_RETRY_BASE_DELAY_SECONDS=0.5
GROQ_REQUEST_TIMEOUT_SECONDS=30
DOCTOR_PHONE=+15551234567
OUTBOUND_TRUNK_ID=your_outbound_sip_trunk_id

# SendGrid Mail Send
SENDGRID_API_KEY=SG_replace_with_your_real_api_key
EMAIL_FROM=verified-sender@yourdomain.com
EMAIL_TO=recipient@example.com
EMAIL_ENABLED=true
EMAIL_TIMEOUT_SECONDS=15

EMAIL_MAX_ATTACHMENT_BYTES=15000000
CALL_RECORDS_DIR=call_records
